# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=3000

# Matches the Postgres container in docker-compose.yml (host port 5434).
DATABASE_URL=postgres://taskflow:taskflow@localhost:5434/taskflow
# Set to true for cloud databases such as Neon.
DB_SSL=false

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# Websites allowed to call the API from a browser ("*" = any). In production use the frontend URL.
CORS_ORIGIN=*

# Database used by `npm test` (created automatically if it does not exist).
TEST_DATABASE_URL=postgres://taskflow:taskflow@localhost:5434/taskflow_test
